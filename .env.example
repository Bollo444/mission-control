# Mission Control — environment (all optional)

# Point the shared-memory Obsidian vault at a custom location.
# Defaults to a "MissionControlVault" folder in your home directory.
# MC_VAULT_DIR=C:\path\to\your\vault

# Provider API keys are NOT read from here — set them in the Settings page,
# which persists them to ~/.mission-control/settings.json (outside the repo).
