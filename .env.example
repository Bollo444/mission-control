# Mission Control — environment (all optional). Copy to .env to use.
# .env is gitignored. Prefer the Settings page for API keys (see note below).

# --- Vault ---------------------------------------------------------------
# Point the shared-memory Obsidian vault at a custom location.
# Defaults to a "MissionControlVault" folder in your home directory.
# MC_VAULT_DIR=C:\path\to\your\vault

# --- Health monitor ------------------------------------------------------
# How often the fleet probes free providers for availability, in minutes.
# Default 360 (6 hours); floored at 5.
# MC_HEALTH_INTERVAL_MIN=360

# --- Local (self-hosted) models ------------------------------------------
# OpenAI-compatible base URL for the "Local" provider (LM Studio / Ollama / vLLM).
# Default http://127.0.0.1:1234/v1  (LM Studio).  Ollama: http://127.0.0.1:11434/v1
# LOCAL_BASE_URL=http://127.0.0.1:1234/v1

# --- Encryption at rest (optional) ---------------------------------------
# When set, provider keys in settings.json are encrypted (AES-256-GCM). Use a
# 32-byte hex string or any passphrase. BACK IT UP — encrypted keys can't be
# recovered without it. Off by default (keys stored plaintext, outside the repo).
# MC_ENCRYPTION_KEY=

# --- Provider API keys ---------------------------------------------------
# RECOMMENDED: set keys in the Settings page. They persist to
# ~/.mission-control/settings.json (OUTSIDE this repo) and are never sent raw
# to the browser.
#
# As an ALTERNATIVE (e.g. CI / read-only deploys) the server will also read any
# provider key from the environment — settings.json takes precedence, env is the
# fallback. If you put keys here, remember .env is gitignored but still on disk.
# OPENCODE_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GITHUB_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# KILOCODE_API_KEY=
# NOUS_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
